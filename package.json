{
  "name": "casper-gacha-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "dev": "npm run build && node --import tsx scripts/serve.ts",
    "start": "npm run dev",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "balance": "node --import tsx scripts/balance.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Dragon Ball card arena practice prototype"
}
