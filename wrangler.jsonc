{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casper-gacha-game",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "casper-arena",
      "database_id": "ae7529d3-093b-47cf-9ffc-30c710e0941d",
      "migrations_dir": "db/migrations"
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 4317
  },
  "account_id": "5576346053b20f27278255cb8f602b12",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "BETTER_AUTH_URL": "https://casper-gacha-game.jfkiii.workers.dev"
  }
}
