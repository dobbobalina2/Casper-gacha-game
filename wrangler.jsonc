{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casper-gacha-game",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "casper-arena",
      "database_id": "ae7529d3-093b-47cf-9ffc-30c710e0941d",
      "migrations_dir": "db/migrations"
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 4317
  },
  "account_id": "5576346053b20f27278255cb8f602b12",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "BETTER_AUTH_URL": "https://casper-gacha-game.jfkiii.workers.dev"
  },
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "43170100",
      "simple": {
        "limit": 180,
        "period": 60
      }
    },
    {
      "name": "INVENTORY_LIMITER",
      "namespace_id": "43170101",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "BATTLE_WRITE_LIMITER",
      "namespace_id": "43170102",
      "simple": {
        "limit": 90,
        "period": 60
      }
    },
    {
      "name": "NEW_BATTLE_LIMITER",
      "namespace_id": "43170103",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "env": {
    "staging": {
      "name": "casper-gacha-game-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "BETTER_AUTH_URL": "http://127.0.0.1:4317"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "casper-arena-staging",
          "database_id": "14b9fd72-434a-492f-922a-0250b2641304",
          "migrations_dir": "db/migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "API_LIMITER",
          "namespace_id": "43170200",
          "simple": {
            "limit": 180,
            "period": 60
          }
        },
        {
          "name": "INVENTORY_LIMITER",
          "namespace_id": "43170201",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "BATTLE_WRITE_LIMITER",
          "namespace_id": "43170202",
          "simple": {
            "limit": 90,
            "period": 60
          }
        },
        {
          "name": "NEW_BATTLE_LIMITER",
          "namespace_id": "43170203",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  }
}
